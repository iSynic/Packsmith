#include <windows.h>
#include "version.h"
#define IDI_PACKSMITH 101
#define IDI_ARCHIVE 102

IDI_PACKSMITH ICON "assets/icons/packsmith.ico"
IDI_ARCHIVE ICON "assets/icons/packsmith-archive.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS VS_FF_PRERELEASE
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Packsmith"
            VALUE "FileDescription", "Packsmith archive manager"
            VALUE "FileVersion", PACKSMITH_VERSION
            VALUE "InternalName", "Packsmith"
            VALUE "OriginalFilename", "Packsmith.exe"
            VALUE "ProductName", "Packsmith"
            VALUE "ProductVersion", PACKSMITH_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
